{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "atliq-etl"
		},
		"atliqserverazure_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'atliqserverazure'"
		},
		"atliqstorageaccount_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'atliqstorageaccount'"
		},
		"atliqserverazure_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "atliq-server-akhil.database.windows.net"
		},
		"atliqserverazure_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "atliq_commerce"
		},
		"atliqserverazure_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CloudSA2e32a063"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "atliq-etl_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"atliqserverazure_password": {
						"value": "[parameters('atliqserverazure_password')]"
					},
					"atliqstorageaccount_connectionString": {
						"value": "[parameters('atliqstorageaccount_connectionString')]"
					},
					"atliqserverazure_properties_typeProperties_server": {
						"value": "[parameters('atliqserverazure_properties_typeProperties_server')]"
					},
					"atliqserverazure_properties_typeProperties_database": {
						"value": "[parameters('atliqserverazure_properties_typeProperties_database')]"
					},
					"atliqserverazure_properties_typeProperties_userName": {
						"value": "[parameters('atliqserverazure_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}